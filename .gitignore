# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
TownBuilder/SourceArt/**/*.png
TownBuilder/SourceArt/**/*.tga

# Binary Files
TownBuilder/Binaries/*
TownBuilder/Plugins/**/Binaries/*

# Builds
TownBuilder/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!TownBuilder/Build/*/
TownBuilder/Build/*/**
!TownBuilder/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!TownBuilder/Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
TownBuilder/Saved/*

# Compiled source files for the engine to use
TownBuilder/Intermediate/*
TownBuilder/Plugins/**/Intermediate/*

# Cache files for the editor to use
TownBuilder/DerivedDataCache/*

# IDE files
.idea/
.vsconfig
*.slnx

# Crash dumps
*.stackdump
